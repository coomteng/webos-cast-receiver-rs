# CI variant: the binary is built by the workflow (musl, static), this only
# assembles the scratch image. Same layout/env as Dockerfile.
FROM scratch
# TARGETARCH is set by buildx per platform (amd64 / arm64); the workflow
# places each native-built binary under out/<arch>/.
ARG TARGETARCH
COPY out/${TARGETARCH}/webos-cast-receiver /webos-cast-receiver
COPY app /app
COPY sim /sim
VOLUME ["/data"]
ENV DATA_DIR=/data APP_DIR=/app SIM_DIR=/sim PORT=8790
EXPOSE 8790
ENTRYPOINT ["/webos-cast-receiver"]
